{
  "manifest_version": 3,
  "name": "Butu",
  "version": "0.1.0",
  "description": "A little teddy bear to keep you company while you focus.",
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/content/content.js"],
    "css": ["src/content/haunt.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["src/content/extract.js", "src/lib/page-text.js", "src/config.js", "assets/doodles/*.svg", "assets/fonts/patrick-hand/PatrickHand-Regular.ttf"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": { "default_title": "Butu", "default_popup": "src/popup/popup.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://huggingface.co https://*.hf.co https://api.elevenlabs.io; media-src 'self' blob:"
  }
}
