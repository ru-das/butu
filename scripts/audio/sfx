#!/usr/bin/env node
// Build-time only. Node standard library + local FFmpeg; never retries.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { pathToFileURL } = require('node:url');
const { createHash } = require('node:crypto');
const root = path.resolve(__dirname, '../..');

async function request(endpoint, body) {
    const response = await fetch(`https://api.elevenlabs.io${endpoint}`, {
        method: body ? 'POST' : 'GET', redirect: 'error', signal: AbortSignal.timeout(120000),
        headers: { 'xi-api-key': process.env.ELEVENLABS_API_KEY,
            ...(body ? { 'Content-Type': 'application/json' } : {}) },
        ...(body ? { body: JSON.stringify(body) } : {}),
    });
    if (!response.ok) {
        const failure = await response.json().catch(() => null);
        const code = failure?.detail?.status;
        throw new Error(`ElevenLabs HTTP ${response.status}${typeof code === 'string' && /^[a-z_]{1,80}$/.test(code) ? ` (${code})` : ''}; stopped without retry.`);
    }
    return response;
}

async function main() {
    const [command, directory, option, ...extra] = process.argv.slice(2);
    if (!command || command === '--help') {
        console.log('Usage: scripts/audio/sfx generate <new-directory> [--local]\nAt most two short free-quota API calls; local fallbacks always included. --local makes no network requests.');
        return;
    }
    if (command !== 'generate' || !directory || (option && option !== '--local') || extra.length) throw new Error('Invalid arguments; use --help.');
    const version = spawnSync('ffmpeg', ['-version'], { encoding: 'utf8' });
    if (version.status !== 0) throw new Error('Install FFmpeg locally before generating audio.');
    const { ELEVENLABS_SFX: config, ELEVENLABS_OUTPUT_FORMAT: format } = await import(pathToFileURL(path.join(root, 'src/config.js')));
    const { SFX_CLIPS, SFX_SAMPLE_RATE, renderSfx } = await import(pathToFileURL(path.join(root, 'src/lib/sfx.js')));
    const output = path.resolve(directory);
    fs.mkdirSync(output); // Existing directories cannot spend quota or be overwritten.
    const hash = file => createHash('sha256').update(fs.readFileSync(path.join(output, file))).digest('hex');
    const manifest = { created_at: new Date().toISOString(), generator: 'scripts/audio/sfx',
        model_id: config.modelId, output_format: format, prompt_influence: config.promptInfluence,
        attribution: 'Sound effects generated with ElevenLabs — elevenlabs.io',
        api_licence: 'Noncommercial; ElevenLabs free-plan terms and attribution required. Not CC0.',
        fallback_licence: 'CC0-1.0; original Butu project synthesis, src/lib/sfx.js',
        encoder: version.stdout.split('\n')[0], reserved_credits: 0, submitted_prompt_characters: 0,
        api_requests: 0, quota_checks: [], clips: [], status: 'local-fallback' };
    const save = () => fs.writeFileSync(path.join(output, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
    for (const clip of SFX_CLIPS) {
        const samples = renderSfx(clip.name);
        const pcm = Buffer.alloc(samples.length * 2);
        samples.forEach((sample, i) => pcm.writeInt16LE(Math.round(sample * 32767), i * 2));
        const file = `${clip.name}.mp3`;
        const fallback = `${clip.name}-fallback.mp3`;
        const raw = path.join(output, `${clip.name}.pcm`);
        fs.writeFileSync(raw, pcm, { flag: 'wx' });
        const encoded = spawnSync('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-f', 's16le',
            '-ar', String(SFX_SAMPLE_RATE), '-ac', '1', '-i', raw, '-map_metadata', '-1',
            '-codec:a', 'libmp3lame', '-b:a', '128k', path.join(output, fallback)], { timeout: 30000 });
        fs.unlinkSync(raw);
        if (encoded.status !== 0) throw new Error('Local SFX encoding failed.');
        fs.copyFileSync(path.join(output, fallback), path.join(output, file));
        manifest.clips.push({ ...clip, file, fallback, fallback_sha256: hash(fallback),
            source: 'local-synthesis', status: 'fallback', reserved_credits: 0 });
    }
    save();
    if (option !== '--local') {
        try {
            try { process.loadEnvFile(path.join(root, '.env')); }
            catch (error) { if (error.code !== 'ENOENT') throw new Error('Could not load project .env.'); }
            if (!process.env.ELEVENLABS_API_KEY?.trim()) throw new Error('No API key; using bundled local effects.');
            const total = SFX_CLIPS.reduce((sum, clip) => sum + clip.duration_seconds * config.creditsPerSecond, 0);
            if (SFX_CLIPS.length > config.maxRequests || total > config.maxCredits) throw new Error('SFX build budget exceeded.');
            for (const clip of manifest.clips) {
                const account = await (await request('/v1/user/subscription')).json();
                if (account.tier !== 'free' || account.can_extend_character_limit !== false ||
                    ![account.character_count, account.character_limit].every(n => Number.isSafeInteger(n) && n >= 0)) throw new Error('Requires verified free quota with overages disabled.');
                const available = Math.max(0, account.character_limit - account.character_count);
                manifest.quota_checks.push({ at: new Date().toISOString(), tier: account.tier,
                    character_count: account.character_count, character_limit: account.character_limit,
                    available_credits: available, overages: false, reset_unix: account.next_character_count_reset_unix });
                save();
                // Subtract this run's reservations even if the service counter lags.
                if (Math.min(available, manifest.quota_checks[0].available_credits - manifest.reserved_credits) < total - manifest.reserved_credits) throw new Error('Insufficient free quota; no further SFX requests.');
                clip.reserved_credits = clip.duration_seconds * config.creditsPerSecond;
                manifest.reserved_credits += clip.reserved_credits;
                manifest.submitted_prompt_characters += clip.prompt.length;
                manifest.api_requests++;
                clip.status = 'request-started';
                save(); // Persist before dispatch, including uncertain/failed requests.
                const response = await request(`/v1/sound-generation?output_format=${format}`, {
                    text: clip.prompt, duration_seconds: clip.duration_seconds,
                    prompt_influence: config.promptInfluence, model_id: config.modelId, loop: false,
                });
                if (!response.headers.get('content-type')?.toLowerCase().startsWith('audio/')) throw new Error('Expected SFX audio.');
                const audio = Buffer.from(await response.arrayBuffer());
                if (!audio.length || audio.length > 5_000_000) throw new Error('Invalid SFX audio size.');
                fs.writeFileSync(path.join(output, clip.file), audio);
                Object.assign(clip, { source: 'ElevenLabs Sound Effects API', status: 'saved',
                    reported_character_cost: response.headers.get('character-cost') });
                save();
            }
            manifest.status = 'api-ready-for-listening';
        } catch (error) {
            manifest.stop_reason = error.message.replaceAll(process.env.ELEVENLABS_API_KEY || '\0', '[REDACTED]');
            console.error(manifest.stop_reason);
        }
    }
    for (const clip of manifest.clips) clip.sha256 = hash(clip.file);
    save();
    console.log(`Saved SFX in ${output}; ${manifest.api_requests} submitted requests, ${manifest.reserved_credits} reserved credits. Local fallbacks retained.`);
}
main().catch(error => {
    console.error(error.message.replaceAll(process.env.ELEVENLABS_API_KEY || '\0', '[REDACTED]'));
    process.exitCode = 1;
});
